# PD-FC-V1 Rev A: B pin map, schematic and physical placement

MCU STM32H7xx STM32H743xx

APJ_BOARD_ID 65535

OSCILLATOR_HZ 16000000

FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128

STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14

DEFAULTGPIO OUTPUT LOW PULLDOWN

# USB and SWD
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Local compilation trial only; board ID 65535 is not a production allocation.
# UART connectors; Raspberry Pi link removed.
SERIAL_ORDER OTG1 USART1 USART2 UART7 USART3 UART4 UART5 UART8

PA9  USART1_TX USART1
PA10 USART1_RX USART1

PD5 USART2_TX  USART2
PD6 USART2_RX  USART2
PD3 USART2_CTS USART2
PD4 USART2_RTS USART2

# ESC1 telemetry input, on the same MCU edge as the TIM1 outputs.
PE7 UART7_RX UART7
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_ESCTelemetry

# New general UARTs. RX uses DMA; TX is interrupt-driven to preserve DMA for RX and motors.
PD8 USART3_TX USART3 NODMA
PD9 USART3_RX USART3
PD1 UART4_TX UART4 NODMA
PD0 UART4_RX UART4
PB13 UART5_TX UART5 NODMA
PB12 UART5_RX UART5
PE1 UART8_TX UART8 NODMA
PE0 UART8_RX UART8

# I2C1 is the internal sensor bus. I2C2 and I2C4 are external.
I2C_ORDER I2C1 I2C2 I2C4

PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

PB8 I2C4_SCL I2C4
PB9 I2C4_SDA I2C4

define HAL_I2C_INTERNAL_MASK 1

# LSM6DSV16X on a dedicated SPI1; package pins 28-31 are consecutive.
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PA4 LSM6DSV_CS CS
PD11 LSM6DSV_DRDY INPUT

SPIDEV lsm6dsv SPI1 DEVID1 LSM6DSV_CS MODE3 2*MHZ 8*MHZ

# Physical axes verified against manufacturer package drawings and PCB pad orientation.
# B.Cu is vehicle upper side; ESC connectors point forward.
# U4 B.Cu, 90 deg: sensor +X rearward, +Y right, +Z up.
IMU LSM6DSV SPI:lsm6dsv ROTATION_PITCH_180
define HAL_DEFAULT_INS_FAST_SAMPLE 1

# SPA06-003 on the internal I2C bus.
BARO SPL06 I2C:0:0x76
COMPASS IST8310 I2C:0:0x0E false ROTATION_YAW_180
COMPASS QMC6309 I2C:0:0x7C false ROTATION_ROLL_180_YAW_90
# Probe external buses (GPS compasses) only. Internal-bus probing found the onboard
# IST8310 first with its default ROTATION_PITCH_180 and the COMPASS line above was
# skipped as a duplicate (bench data 2026-11-03, design/reports/compass-orientation-20261103/).
define AP_COMPASS_PROBING_ENABLED 1
define AP_COMPASS_INTERNAL_BUS_PROBING_ENABLED 0

# microSD
PC8  SDMMC1_D0  SDMMC1
PC9  SDMMC1_D1  SDMMC1
PC10 SDMMC1_D2  SDMMC1
PC11 SDMMC1_D3  SDMMC1
PC12 SDMMC1_CK  SDMMC1
PD2  SDMMC1_CMD SDMMC1

define FATFS_HAL_DEVICE SDCD1
define HAL_OS_FATFS_IO 1

# Compilation trial for 8-pin + 8-pin connectors carrying 4 + 6 motor signals.
# ESC1 main outputs: four TIM1 channels.
PE14 TIM1_CH4 TIM1 PWM(1) GPIO(50) BIDIR
PE13 TIM1_CH3 TIM1 PWM(2) GPIO(51) BIDIR
PE11 TIM1_CH2 TIM1 PWM(3) GPIO(52) BIDIR
PE9  TIM1_CH1 TIM1 PWM(4) GPIO(53) BIDIR

# ESC2 main outputs: pins 59-64 of the LQFP100 package.
PD12 TIM4_CH1 TIM4 PWM(5) GPIO(54) BIDIR
PD13 TIM4_CH2 TIM4 PWM(6) GPIO(55) BIDIR
PD14 TIM4_CH3 TIM4 PWM(7) GPIO(56) BIDIR
# TIM4 CH4 captures through the paired CH3; there is no TIM4_CH4 DMA request.
PD15 TIM4_CH4 TIM4 PWM(8) GPIO(57)
PC6  TIM8_CH1 TIM8 PWM(9) GPIO(58) BIDIR
PC7  TIM8_CH2 TIM8 PWM(10) GPIO(59) BIDIR

# Separate timer for the onboard pixel and external strip (parallel, same pixel 1).
PA0 TIM5_CH1 TIM5 PWM(11) GPIO(60)
define AP_NOTIFY_NEOPIXEL_MASK 1024
define DEFAULT_NTF_LED_TYPES 256

# RC input and buzzer
PB3 TIM2_CH2 TIM2 RCININT PULLDOWN LOW
PE5 TIM15_CH1 TIM15 GPIO(32) ALARM

# Battery voltage divider: 200k high side, 22k low side.
PC4 BATT_VOLTAGE_SENS ADC1 SCALE(1)
# ESC current 0-5V -> 10k/15k divider -> PC5, 100nF filter. Calibration required.
PC5 BATT_CURRENT_SENS ADC1 SCALE(1)

define HAL_BATT_MONITOR_DEFAULT 3
define HAL_BATT_VOLT_PIN 4
define HAL_BATT_CURR_PIN -1
define HAL_BATT_CURR_SCALE 1.0
define HAL_BATT_VOLT_SCALE 10.090909
# Voltage-only default until the ESC current output is calibrated.
# To enable current measurement: BATT_MONITOR=4, BATT_CURR_PIN=8.
# ADC voltage = 0.6 * ESC sensor voltage. Set BATT_AMP_PERVLT and
# BATT_AMP_OFFSET from measured current; 1.0 is not an ESC calibration.

DMA_PRIORITY SPI1* TIM* USART*_RX UART*_RX ADC* USART*_TX UART*_TX

# PPP networking over a serial port (SERIALn_PROTOCOL = 48) and serial device registration
# (used by networking / scripting serial devices), same pattern as CubeOrangePlus.
define AP_NETWORKING_BACKEND_PPP 1
define AP_SERIALMANAGER_REGISTER_ENABLED 1

env BUILD_ABIN True
