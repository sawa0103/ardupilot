# hw definition file for the PD-FC-V1 bootloader

MCU STM32H7xx STM32H743xx

APJ_BOARD_ID 65535

OSCILLATOR_HZ 16000000

FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

DEFAULTGPIO OUTPUT LOW PULLDOWN

# USB and USART1 bootloader upload interfaces
SERIAL_ORDER OTG1 USART1

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA9  USART1_TX USART1
PA10 USART1_RX USART1

# SWD and IMU chip select
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD
PA4 LSM6DSV_CS CS
